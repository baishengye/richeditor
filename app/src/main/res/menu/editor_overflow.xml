<?xml version="1.0" encoding="utf-8"?>
<!--
  更多菜单。

  分组语义：
   - 第 1 组「块级样式」：正文/标题 1-3 互斥（checkableBehavior=single），
     系统自动保证同时只勾选一项，与 EditorSnapshot.heading 的单值语义一致。
   - 第 2 组「列表与引用」：可各自独立勾选（列表项里可以再嵌引用）。
   - 第 3、4 组：一次性动作，无勾选态。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <group android:checkableBehavior="single">
        <item
            android:id="@id/menu_paragraph"
            android:title="@string/menu_paragraph" />
        <item
            android:id="@id/menu_heading1"
            android:title="@string/menu_heading1" />
        <item
            android:id="@id/menu_heading2"
            android:title="@string/menu_heading2" />
        <item
            android:id="@id/menu_heading3"
            android:title="@string/menu_heading3" />
    </group>

    <group>
        <item
            android:id="@id/menu_bullet_list"
            android:checkable="true"
            android:title="@string/menu_bullet_list" />
        <item
            android:id="@id/menu_ordered_list"
            android:checkable="true"
            android:title="@string/menu_ordered_list" />
        <item
            android:id="@id/menu_blockquote"
            android:checkable="true"
            android:title="@string/menu_blockquote" />
        <item
            android:id="@id/menu_code_block"
            android:checkable="true"
            android:title="@string/menu_code_block" />
        <item
            android:id="@id/menu_code"
            android:checkable="true"
            android:title="@string/menu_code" />
    </group>

    <group>
        <item
            android:id="@id/menu_link"
            android:title="@string/menu_link" />
        <item
            android:id="@id/menu_unlink"
            android:title="@string/menu_unlink" />
        <item
            android:id="@id/menu_remove_image"
            android:title="@string/menu_remove_image" />
        <item
            android:id="@id/menu_divider"
            android:title="@string/menu_divider" />
    </group>

    <group>
        <item
            android:id="@id/menu_undo"
            android:title="@string/menu_undo" />
        <item
            android:id="@id/menu_redo"
            android:title="@string/menu_redo" />
        <item
            android:id="@id/menu_select_all"
            android:title="@string/menu_select_all" />
        <item
            android:id="@id/menu_clear"
            android:title="@string/menu_clear" />
    </group>
</menu>
