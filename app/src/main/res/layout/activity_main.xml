<?xml version="1.0" encoding="utf-8"?>
<!--
  示例界面：工具栏固定在顶部，编辑器占满剩余空间并自行滚动。

  为什么不做「整页滚动 + WebView 自动高度」：
  那样需要把 WebView 放进 ScrollView，而 WebView 会与父容器的滚动手势互相争夺，
  是 Android 上出了名的坑。工具栏固定 + WebView 内部滚动既符合编辑器类应用的通行做法，
  也避开了这个坑。
  如果确实需要「整页滚动」效果（例如编辑器只是长表单中的一项），
  可以监听 EditorEventListener.onHeightChanged 动态改 WebView 的高度，
  并配合 RichEditorView 的 autoHeight（默认开启）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.itc.richeditor.EditorToolbar
        android:id="@+id/editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <com.itc.richeditorv2.RichEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!--
      状态栏：左边是 emoji 输入开关（演示 RichEditorView.setAllowEmojiInput），
      右边是字数（数据来自 EditorEventListener.onCharacterCountChanged）。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/emoji_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="@string/allow_emoji"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/count_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingVertical="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="共 0 字" />
    </LinearLayout>

</LinearLayout>